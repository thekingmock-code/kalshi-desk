# Kalshi Trade API (production). Never commit real values.
KALSHI_ACCESS_KEY=your-api-key-id
# PEM contents (use \n for newlines) OR point to a file:
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.pem
# Optional override:
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Optional Telegram bot (/start, /status, /composite). Never commit the real token.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=   # from /start after the bot is running; restricts who gets replies
